# Local PostgreSQL connection (copy to server/.env and set your own password).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=si_tutor
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_postgres_password

DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# Local development is enabled by default. Production defaults to closed.
# Use allowlist only for controlled Resend testing; list the Resend account email.
REGISTRATION_MODE=enabled
REGISTRATION_TEST_EMAILS=

# Keep blank for local development-link testing. Never expose these in VITE_ variables.
RESEND_API_KEY=
EMAIL_FROM=

AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
TRUST_PROXY=0
